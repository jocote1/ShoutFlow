# ShoutFlow API Keys & Environment Configuration
# Place this file at ~/.config/shoutflow/.env or in the project root .env

# Groq API Key (Recommended for ultra-fast <300ms Whisper and LLM cleanups)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=

# OpenAI API Key (For OpenAI Whisper and GPT models)
# Get your key at: https://platform.openai.com
OPENAI_API_KEY=

# Anthropic API Key (Optional, for Claude cleanup)
ANTHROPIC_API_KEY=

# Custom LLM API Key (For local Ollama or custom OpenAI-compatible proxies)
LLM_API_KEY=
